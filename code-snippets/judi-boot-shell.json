{
  "judi boot shell": {
    "prefix": "judi boot shell",
    "tags": ["judi", "boot", "shell"],
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"en\">",
      "<head>",
      "  <meta charset=\"UTF-8\">",
      "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "",
      "  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css\" ",
      "    rel=\"stylesheet\"",
      "    integrity=\"sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD\" ",
      "    crossorigin=\"anonymous\">",
      "  <link rel=\"stylesheet\" href=\"./style.css\">",
      "  <link rel=\"shortcut icon\" href=\"sql favicon.ico\" type=\"image/x-icon\">",
      "",
      "  <title>logo maker</title>",
      "</head>",
      "<body>",
      "  <div id=\"app\">",
      "    <home-navbar></home-navbar>",
      "    <div class=\"container\">",
      "      <div class=\"flex-row mt-3\" steve-name=\"title row\">",
      "        <h3>Logo Maker</h3>",
      "",
      "        <div class=\"vert-input\" steve-name=\"width\">",
      "          <label for=\"width\">width</label>",
      "          <input type=\"number\" id=\"width\" v-model=\"width\" ",
      "                class=\"form-control\" style=\"width:5em;\" />",
      "        </div>",
      "        <tpanel :row-count=\"width\"></tpanel>",
      "",
      "<div class=\"vert-input vert-input-center\" steve-name=\"numRows\">  ",
      "  <label for=\"numRows\">number textarea rows</label>",
      "  <input type=\"number\" id=\"numRows\" v-model=\"numRows\" class=\"form-control\" ",
      "          style=\"width:5em;\" />",
      "</div>",
      "",
      "<button class=\"btn btn-secondary\" @click=\"setBlock_click( );\">set editLineBlock</button>",
      "",
      "<div class=\"vert-input vert-input-center\" steve-name=\"numLines\">",
      "  <label for=\"numLines\">number text lines</label>",
      "  <input type=\"number\" id=\"numLines\" v-model=\"numLines\" class=\"form-control\" ",
      "          style=\"width:5em;\" />",
      "</div>",
      "",
      "      </div>",
      "      ",
      "      <div class=\"main-container mt-3\">",
      "        <div class=\"side-by-side-panel\">",
      "",
      "        <textarea style=\"box-sizing: border-box; width:100%;  ",
      "                  padding:1em;font-family:Lucida Console;\" ",
      "                  id=\"drawInstructions\"",
      "                  v-model=\"drawInstructions\" ",
      "                  @dblclick=\"drawInstructions_dblclick($event); editLineBlock = {linn};\" ",
      "                  @mousemove=\"drawInstructions_mousemove();\"",
      "                  @blur=\"drawInstructions_blur();\"",
      "                  :rows=\"numRows\">",
      "        </textarea>",
      "",
      "        <edit-line-modal v-if=\"editLineBlock\" ",
      "        @click=\"editLineBlock_click( )\"",
      "              @$-close=\"editLineBlock_clear( )\">",
      "        </edit-line-modal>",
      "",
      "        <div class=\"flex-row mt-3\">",
      "          <div class=\"vert-input\">",
      "            <label for=\"linn\">Cursor line number</label>",
      "            <input type=\"text\" id=\"linn\" name=\"linn\" ",
      "                    class=\"form-control\" v-model=\"linn\">",
      "          </div>",
      "          <div class=\"vert-input\">",
      "            <label for=\"coln\">Cursor column number</label>",
      "            <input type=\"text\" id=\"coln\" name=\"coln\" class=\"form-control\" v-model=\"coln\">",
      "          </div>",
      "",
      "        </div>",
      "",
      "        <div class=\"flex-row mt-3\">",
      "          <div class=\"vert-input\">",
      "            <label for=\"dim_width\">Width</label>",
      "            <input type=\"number\" id=\"dim_width\" name=\"dim_width\" ",
      "                    class=\"form-control\" v-model=\"dim.x\">",
      "          </div>",
      "          <div class=\"vert-input\">",
      "            <label for=\"dim_height\">Height</label>",
      "            <input type=\"text\" id=\"dim_height\" name=\"dim_height\" ",
      "                    class=\"form-control\" v-model=\"dim.y\">",
      "          </div>",
      "",
      "          <div class=\"vert-input\">",
      "            <label for=\"clientY\">clientY</label>",
      "            <input type=\"text\" id=\"clientY\" name=\"clientY\" ",
      "                    class=\"form-control\" v-model=\"clientY\">",
      "          </div>",
      "          <div class=\"vert-input\">",
      "            <label for=\"lineHeight\">lineHeight</label>",
      "            <input type=\"text\" id=\"lineHeight\" name=\"lineHeight\" ",
      "                    class=\"form-control\" v-model=\"lineHeight\">",
      "          </div>  ",
      "          <div class=\"vert-input\">",
      "            <label for=\"top\">top</label>",
      "            <input type=\"text\" id=\"top\" name=\"top\" ",
      "                    class=\"form-control\" v-model=\"top\">",
      "          </div>",
      "          <div class=\"vert-input\">",
      "            <label for=\"scrollTop\">scrollTop</label>",
      "            <input type=\"text\" id=\"scrollTop\" name=\"scrollTop\" ",
      "                    class=\"form-control\" v-model=\"scrollTop\">",
      "          </div>  ",
      "",
      "        </div>",
      "      </div>",
      "",
      "        <div id=\"drawPanel\" class=\"side-by-side-panel\">",
      "        </div>",
      "      </div>",
      "",
      "    </div>",
      "  </div>",
      "",
      "  <script src=\"./app.mjs\" type=\"module\"></script>",
      "  <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js\"",
      "    integrity=\"sha384-OERcA2EqjJCMA+/3y+gxIOqMEjwtxJY7qPCqsdltbNJuaOe923+mo//f6V8Qbsw3\" ",
      "    crossorigin=\"anonymous\"></script>",
      "",
      "</body>",
      "</html>"
    ],
    "description": "judi boot shell"
  }
}
